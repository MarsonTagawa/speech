{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speech",
  "version": "0.1.0",
  "identifier": "com.marsont.speech",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Speech",
        "width": 1120,
        "height": 740,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "rpm": {
        "compression": { "type": "none" }
      }
    }
  }
}
