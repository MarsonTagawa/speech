{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speech",
  "version": "0.2.2",
  "identifier": "com.marsont.speech",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Speech",
        "width": 1120,
        "height": 740,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "rpm": {
        "compression": { "type": "none" }
      }
    },
    "windows": {
      "nsis": {
        "compression": "none"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QUE5NjFBNEE4QjhBMEIKUldRTGlvdEtHcGFxR2V0UHUvT2xGLzc1N280ZEN5cEdvMm5HcGxoZHQyQStsNHdtM0NmZ3pzcDkK",
      "endpoints": [
        "https://github.com/MarsonTagawa/speech/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
