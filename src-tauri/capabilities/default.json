{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and notch windows",
  "windows": [
    "main",
    "notch"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:path:default",
    "core:app:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen"
  ]
}
